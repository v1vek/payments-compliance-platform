# App connects with the least-privileged role
DATABASE_URL=postgres://meridian_app:app_pw@localhost:5433/meridian
# Migrations and seed run as the schema owner (defaults to DATABASE_URL if unset)
OWNER_DATABASE_URL=postgres://meridian_owner:owner_pw@localhost:5433/meridian
PORT=4000
SANCTIONS_TIMEOUT_MS=5000
REVIEW_THRESHOLD_CENTS=800000
# Enables the "Reset demo data" button (opens a fresh customer account; never deletes history)
DEMO_MODE=true
