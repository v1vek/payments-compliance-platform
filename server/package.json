{
  "name": "@meridian/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "migrate": "tsx --env-file-if-exists=../.env scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:prod": "node dist/scripts/migrate.js && node dist/scripts/seed.js && node dist/src/index.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
